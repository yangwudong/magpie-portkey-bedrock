{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jack-yang/magpie-portkey-bedrock",
  "version": "1.1.0",
  "description": "Portkey AWS Bedrock provider for Magpie and pi, with tools, vision, reasoning and prompt caching. Built on @ai-sdk/amazon-bedrock.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangwudong/magpie-portkey-bedrock.git"
  },
  "homepage": "https://github.com/yangwudong/magpie-portkey-bedrock#readme",
  "bugs": {
    "url": "https://github.com/yangwudong/magpie-portkey-bedrock/issues"
  },
  "type": "module",
  "main": "./index.ts",
  "magpie": {
    "icon": "data:image/svg+xml;base64,"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "magpie-plugin",
    "provider",
    "magpie",
    "portkey",
    "bedrock",
    "amazon-bedrock"
  ],
  "files": [
    "index.ts",
    "config.json",
    "models.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19",
    "bun": ">=1.3"
  },
  "scripts": {
    "test": "bun test test/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.116",
    "ai": "7.0.141"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
